// Prisma schema — Florescer Kids
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAE
  PROFESSORA
  ADMIN
}

enum BookingStatus {
  PENDENTE
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

// Mensagens automáticas de relacionamento (não transacionais). Cada tipo é um
// gatilho diferente, disparado pelo cron de engajamento.
enum MessageKind {
  CADASTRO_SEM_AGENDAMENTO
  RESERVA_PENDENTE_PROFESSORA
  PEDIDO_AVALIACAO
  CONVITE_INDICACAO
  REENGAJAMENTO_30_DIAS
}

enum BookingModality {
  ONLINE
  DOMICILIO_CASA_ALUNO
  DOMICILIO_CASA_PROFESSORA
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          Role     @default(MAE)
  createdAt     DateTime @default(now())
  // Descadastro das mensagens de relacionamento. Não afeta e-mail
  // transacional (redefinição de senha, aviso de aula) — esse é parte do
  // serviço contratado, não comunicação opcional.
  unsubscribedAt DateTime?

  teacherProfile TeacherProfile?
  bookingsAsMae  Booking[]        @relation("BookingsAsMae")
  resetTokens    PasswordResetToken[]
  reviews        Review[]         @relation("ReviewsAsMae")
  messageLogs    MessageLog[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeacherProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String
  specialties  String
  credentials  String?
  whatsapp     String
  photoUrl     String?
  videoCallLink String?
  // E-mail real onde ela recebe avisos (nova aula agendada etc). Separado do
  // e-mail de login, que pode estar num domínio sem caixa de entrada de
  // verdade — não dá pra assumir que são o mesmo endereço.
  notificationEmail String?
  pricePerHour Float    @default(0)
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Atendimento a domicílio (Cotia-SP e região) — opcional, além do online.
  offersDomicilio        Boolean @default(false)
  pricePerHourDomicilio  Float?
  // Endereço da professora, usado quando o aluno vai até a casa dela.
  // Só é revelado pra mãe depois que a aula é confirmada (mesmo padrão do
  // videoCallLink no atendimento online).
  domicilioAddress       String?

  availabilities Availability[]
  bookings       Booking[]       @relation("BookingsAsTeacher")
  reviews        Review[]
  blockedDates   BlockedDate[]
}

model BlockedDate {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime       @default(now())

  @@unique([teacherId, date])
}

model Availability {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
}

// Também existe um índice único parcial no banco (teacherId, date, startTime
// onde status IN (PENDENTE, CONFIRMADA)) — não representável aqui na sintaxe
// do Prisma, criado à mão na migração add_booking_slot_unique_index. É ele
// que garante, no banco, que duas reservas não fiquem com o mesmo horário
// mesmo em caso de corrida entre requisições simultâneas.
model Booking {
  id         String        @id @default(cuid())
  maeId      String
  mae        User          @relation("BookingsAsMae", fields: [maeId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    TeacherProfile @relation("BookingsAsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  childName  String
  date       DateTime
  startTime  String
  endTime    String
  notes      String?
  teacherNote String?
  status     BookingStatus @default(PENDENTE)
  modality   BookingModality @default(ONLINE)
  // Endereço do aluno, só usado quando modality = DOMICILIO_CASA_ALUNO (a
  // professora vai até a casa da família). Visível só pra essa mãe e pra
  // professora, nunca público.
  address    String?
  createdAt  DateTime      @default(now())

  review     Review?
}

// Registro simples de tentativas (login, cadastro, recuperação de senha) pra
// rate limiting — cada linha é uma tentativa; contamos quantas existem numa
// janela de tempo pra decidir se bloqueia. Sem TTL automático: linhas antigas
// só ficam ocupando espaço (irrelevante no volume desse site), não é
// limpo por enquanto.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  maeId     String
  mae       User     @relation("ReviewsAsMae", fields: [maeId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// Registro do que já foi enviado, para nunca repetir a mesma mensagem para a
// mesma pessoa. A garantia real está no índice único de `dedupeKey`: se o cron
// rodar duas vezes (nova tentativa, deploy no meio da execução), a segunda
// gravação falha e o envio é pulado, em vez de duplicar na caixa de entrada.
model MessageLog {
  id        String      @id @default(cuid())
  kind      MessageKind
  dedupeKey String      @unique
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt    DateTime    @default(now())

  @@index([kind, sentAt])
}

// Prospecção de parceiros institucionais — escolas, creches e consultórios que
// atendem o mesmo público e podem encaminhar famílias.
//
// Só entram aqui organizações com contato PUBLICADO para receber contato
// comercial (o que o Google Places devolve de uma ficha de empresa). Mãe é
// pessoa física: dado dela não é prospectado, chega pelo site ou por indicação.
enum ProspectKind {
  ESCOLA_INFANTIL
  CRECHE
  CLINICA_PEDIATRICA
  PSICOLOGIA
  FONOAUDIOLOGIA
  OUTRO
}

// O fluxo é deliberadamente travado em APROVADO: o robô encontra e redige, mas
// nada sai daqui sem alguém ter lido. Cinquenta e-mails revisados valem mais
// que mil disparados, e o domínio de envio é o mesmo dos e-mails transacionais
// — queimá-lo derrubaria confirmação de aula e reset de senha junto.
enum ProspectStatus {
  ENCONTRADO
  APROVADO
  CONTATADO
  RESPONDEU
  SEM_RESPOSTA
  DESCARTADO
}

model Prospect {
  id      String       @id @default(cuid())
  // Identificador da ficha no Google Places. É a chave natural da busca: com
  // ela, rodar o script de novo atualiza o registro existente em vez de criar
  // uma segunda linha da mesma escola.
  placeId String       @unique
  kind    ProspectKind
  status  ProspectStatus @default(ENCONTRADO)

  name    String
  address String
  // Distância até a base (Cotia), em km. Guardada no momento da busca para
  // ordenar a fila sem recalcular — parceria perto é a que dá aula presencial.
  distanceKm Float

  phone   String?
  website String?
  // O Places não devolve e-mail; este vem do site da própria instituição,
  // quando ela publica um. Sem e-mail, o contato é por telefone, na mão.
  email   String?
  // Quando o site foi visitado à procura de e-mail. Marca a tentativa, não o
  // sucesso: sem isso, toda rodada de enriquecimento tentaria de novo os
  // mesmos sites que não publicam endereço nenhum, e a fila nunca terminaria.
  emailCheckedAt DateTime?

  rating      Float?
  ratingCount Int?

  // Rascunho do primeiro contato, gerado na busca e editável antes do envio.
  draftSubject String?
  draftBody    String?

  notes       String?
  contactedAt DateTime?
  // Segundo toque, mandado dias depois quando o primeiro nao teve resposta.
  // Em prospeccao fria boa parte do retorno vem daqui, nao do primeiro e-mail.
  followUpAt  DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, distanceKm])
  @@index([status, contactedAt])
  @@index([kind])
}
