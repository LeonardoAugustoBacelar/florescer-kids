# Copie este arquivo para .env e preencha os valores reais.

# Connection string do Postgres (Neon). Veja o README para o passo a passo.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Número de WhatsApp da equipe/clínica (DDI+DDD, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# URL pública do site (usada nos links de e-mail e no metadata de SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Conta do Gmail usada para enviar e-mails transacionais via SMTP (Nodemailer)
GMAIL_USER=""

# Senha de app do Gmail — gere em myaccount.google.com/apppasswords
# (não é a senha normal da conta; exige verificação em duas etapas ativada)
GMAIL_APP_PASSWORD=""

# DSN do projeto no Sentry (sentry.io), para monitoramento de erros. Opcional em dev.
NEXT_PUBLIC_SENTRY_DSN=""

# Gere com: openssl rand -base64 32
# Usado para proteger a rota /api/cron/booking-reminders (lembrete de aula do dia seguinte).
# Configure a mesma chave nas variáveis de ambiente do projeto na Vercel — o cron job
# configurado em vercel.json envia esse valor automaticamente no header Authorization.
CRON_SECRET=""

# --- Apenas para o seed (`npm run db:seed`), nunca em produção ---

# Senha das contas criadas pelo seed. Se ficar vazia, o script sorteia uma e
# imprime no terminal — nunca existe senha fixa conhecida no repositório.
SEED_PASSWORD=""

# "true" cria também as contas de demonstração (mãe e admin) para desenvolver.
# Deixe fora de qualquer ambiente que aponte para o banco de produção: a conta
# admin dá acesso ao painel que aprova professoras e vê todas as reservas.
SEED_DEMO_ACCOUNTS=""
